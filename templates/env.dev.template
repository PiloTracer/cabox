# ════════════════════════════════════════════════════════════
# CABOX — Store Template for spawn_store.sh
# Placeholders injected: {{STORE_NAME}}, {{APP_PORT}},
# {{NGINX_PORT}}, {{DB_PORT}}, {{PGBOUNCER_PORT}}, {{REDIS_PORT}}
# Copy this file: cp templates/env.dev.template .env.dev then fill in values
# ════════════════════════════════════════════════════════════

# ── Store Identity ────────────────────────────────────────────
STORE_NAME="{{STORE_NAME}}"
NEXT_PUBLIC_STORE_NAME="{{STORE_NAME}}"
NEXT_PUBLIC_STORE_TAGLINE="Bien elegido"
NEXT_PUBLIC_SUPPORT_WHATSAPP="PLACEHOLDER_+506XXXXXXXX"

# ── Docker Ports ──────────────────────────────────────────────
APP_PORT={{APP_PORT}}
NGINX_PORT={{NGINX_PORT}}
DB_PORT={{DB_PORT}}
PGBOUNCER_PORT={{PGBOUNCER_PORT}}
REDIS_PORT={{REDIS_PORT}}

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://{{STORE_NAME}}_user:{{STORE_NAME}}_pass@pgbouncer:5432/{{STORE_NAME}}_dev?schema=public&pgbouncer=true"
# Direct connection for Prisma migrations (bypasses PgBouncer — required for DDL)
DATABASE_URL_DIRECT="postgresql://{{STORE_NAME}}_user:{{STORE_NAME}}_pass@db:5432/{{STORE_NAME}}_dev"
POSTGRES_USER="{{STORE_NAME}}_user"
POSTGRES_PASSWORD="{{STORE_NAME}}_pass"
POSTGRES_DB="{{STORE_NAME}}_dev"

# ── Auth ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="PLACEHOLDER_run_openssl_rand_-base64_32"
# Match the URL you use in the browser (via nginx below, or :{{APP_PORT}} for direct app only)
NEXTAUTH_URL="http://localhost:{{NGINX_PORT}}"
ADMIN_EMAIL="PLACEHOLDER_admin@yourdomain.com"
# Generate: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH="PLACEHOLDER_bcrypt_hash_of_your_password"
# Plaintext seed password for prisma db seed only (hashed in DB; remove after first deploy)
ADMIN_SEED_PASSWORD="PLACEHOLDER_change_after_seed"

# ── Manual Payments ───────────────────────────────────────────
SINPE_PHONE_NUMBER="PLACEHOLDER_+506XXXXXXXX"
SINPE_ACCOUNT_NAME="PLACEHOLDER_Full Name"
BANK_NAME="PLACEHOLDER_Banco Nacional"
BANK_IBAN="PLACEHOLDER_CR00 0000 0000 0000 0000 00"
BANK_ACCOUNT_NAME="PLACEHOLDER_Full Name"

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY="PLACEHOLDER_sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="PLACEHOLDER_pk_test_..."
STRIPE_WEBHOOK_SECRET="PLACEHOLDER_whsec_..."

# ── PayPal ────────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID="PLACEHOLDER_..."
PAYPAL_CLIENT_SECRET="PLACEHOLDER_..."
PAYPAL_MODE="sandbox"

# ── Google APIs ───────────────────────────────────────────────
# GEMINI_API_KEY — Powers AI product auto-fill from photo upload
# Get FREE key (no billing required) at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="PLACEHOLDER_..."
# GOOGLE_CSE — Powers image search for illustrative product photos
# Step 1: Create a CSE at https://cse.google.com (enable Image Search + search entire web)
# Step 2: Enable "Custom Search API" in the same GCP project
# GOOGLE_CSE_API_KEY can be the same key as GEMINI_API_KEY if same GCP project
GOOGLE_CLOUD_VISION_API_KEY="PLACEHOLDER_..."
GOOGLE_CSE_API_KEY="PLACEHOLDER_..."
GOOGLE_CSE_SEARCH_ENGINE_ID="PLACEHOLDER_..."

# ── Perplexity ────────────────────────────────────────────────
PERPLEXITY_API_KEY="PLACEHOLDER_pplx-..."

# ── WhatsApp Business Cloud API ───────────────────────────────
WHATSAPP_PHONE_NUMBER_ID="PLACEHOLDER_..."
WHATSAPP_ACCESS_TOKEN="PLACEHOLDER_..."
WHATSAPP_VERIFY_TOKEN="PLACEHOLDER_random_string_you_choose"
WHATSAPP_BUSINESS_ACCOUNT_ID="PLACEHOLDER_..."

# ── Supabase Storage ──────────────────────────────────────────
SUPABASE_URL="PLACEHOLDER_https://xxx.supabase.co"
SUPABASE_ANON_KEY="PLACEHOLDER_..."
SUPABASE_SERVICE_ROLE_KEY="PLACEHOLDER_..."

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:{{NGINX_PORT}}"
NEXT_PUBLIC_DEFAULT_LOCALE="es"
NEXT_PUBLIC_CURRENCY="CRC"

# ── Meta / Social Commerce ────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID="PLACEHOLDER_..."
META_CAPI_ACCESS_TOKEN="PLACEHOLDER_..."
META_CAPI_PIXEL_ID="PLACEHOLDER_..."

# ── Error Monitoring ──────────────────────────────────────────
SENTRY_DSN="PLACEHOLDER_https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_AUTH_TOKEN="PLACEHOLDER_..."
NEXT_PUBLIC_SENTRY_DSN="PLACEHOLDER_https://xxx@xxx.ingest.sentry.io/xxx"

# ── Transactional Email ───────────────────────────────────────
SENDGRID_API_KEY="PLACEHOLDER_SG.xxx"
EMAIL_FROM="{{STORE_NAME}} <PLACEHOLDER_orders@yourdomain.com>"

# ── Rate Limiting (Upstash Redis) ─────────────────────────────
UPSTASH_REDIS_REST_URL="PLACEHOLDER_https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="PLACEHOLDER_..."

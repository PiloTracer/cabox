# ════════════════════════════════════════════════════════════
# CABOX — Production environment template (copy to .env.prd)
# BETTER USE: templates/env.dev.template <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
# Start: docker compose -f docker-compose.prd.yml --env-file .env.prd up -d
# Dev template: templates/env.dev.template → copy to .env.dev
# ════════════════════════════════════════════════════════════

# ── Store Identity ────────────────────────────────────────────
STORE_NAME="cabox"
NEXT_PUBLIC_STORE_NAME="Cabox"
NEXT_PUBLIC_STORE_TAGLINE="Bien elegido"
NEXT_PUBLIC_SUPPORT_WHATSAPP="PLACEHOLDER_+506XXXXXXXX"

# ── Docker Ports ──────────────────────────────────────────────
APP_PORT=3000
# NGINX_PORT=8080  # Not used in prod — nginx binds 80/443 directly
DB_PORT=5432
PGBOUNCER_PORT=6432
REDIS_PORT=6379

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://cabox_prd:a6R9bKnc8VwRAfCqi44hOVvEy9bnM2kVWY%2BRly%2Bj5Uw%3D@pgbouncer:5432/cabox_prd?schema=public&pgbouncer=true"
# Direct connection for Prisma migrations (bypasses PgBouncer — required for DDL)
DATABASE_URL_DIRECT="postgresql://cabox_prd:a6R9bKnc8VwRAfCqi44hOVvEy9bnM2kVWY%2BRly%2Bj5Uw%3D@postgres:5432/cabox_prd"
POSTGRES_USER="cabox_prd"
POSTGRES_PASSWORD="a6R9bKnc8VwRAfCqi44hOVvEy9bnM2kVWY+Rly+j5Uw="
POSTGRES_DB="cabox_prd"

# ── Auth ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="PC2hagfb2tVXboic2bE2iCQ6epoLBJwU"
# Match the URL you use in the browser (via nginx below, or :{{APP_PORT}} for direct app only)
NEXTAUTH_URL="http://localhost:{{NGINX_PORT}}"
ADMIN_EMAIL="PLACEHOLDER_admin@yourdomain.com"
# Generate: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH="PLACEHOLDER_bcrypt_hash_of_your_password"
# Plaintext seed password for prisma db seed only (hashed in DB; remove after first deploy)
ADMIN_SEED_PASSWORD="PLACEHOLDER_change_after_seed"

# ── Manual Payments ───────────────────────────────────────────
SINPE_PHONE_NUMBER="PLACEHOLDER_+506XXXXXXXX"
SINPE_ACCOUNT_NAME="PLACEHOLDER_Full Name"
BANK_NAME="PLACEHOLDER_Banco Nacional"
BANK_IBAN="PLACEHOLDER_CR00 0000 0000 0000 0000 00"
BANK_ACCOUNT_NAME="PLACEHOLDER_Full Name"

# ── Stripe ────────────────────────────────────────────────────

# ── Google APIs ───────────────────────────────────────────────
# GEMINI_API_KEY — Powers AI product auto-fill from photo upload
# Get FREE key (no billing required) at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
# GOOGLE_CSE — Powers image search for illustrative product photos
# Step 1: Create a CSE at https://cse.google.com (enable Image Search + search entire web)
# Step 2: Enable "Custom Search API" in the same GCP project
# GOOGLE_CSE_API_KEY can be the same key as GEMINI_API_KEY if same GCP project
GOOGLE_CLOUD_VISION_API_KEY="PLACEHOLDER_..."
GOOGLE_CSE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_CSE_SEARCH_ENGINE_ID="yyyyyyyyyyyyyyyyyyy"

# ── Perplexity ────────────────────────────────────────────────

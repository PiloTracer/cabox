# syntax=docker/dockerfile:1
# Production Dockerfile — multi-stage standalone build for Cabox Next.js app
# Stage 1: deps — install all node_modules
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat python3 make g++
WORKDIR /app
COPY package.json package-lock.json* ./
# loglevel=error: suppress npm "deprecated" spam from transitive deps (still fails on real errors)
RUN npm install --legacy-peer-deps --no-audit --no-fund --loglevel=error

# Stage 2: builder — Prisma generate cached when only app code changes
FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY prisma/schema.prisma prisma/schema.prisma
RUN npx prisma generate
COPY . .
RUN npm run build

# Stage 3: runner — production image (standalone output)
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

RUN apk add --no-cache postgresql-client && \
    addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

# Copy standalone build artifacts
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static      ./.next/static
COPY --from=builder /app/public            ./public
COPY --from=builder /app/prisma            ./prisma

# Schema apply + start (no full node_modules — smaller image, faster deploy)
COPY <<'EOF' /app/entrypoint.sh
#!/bin/sh
set -e
export NO_COLOR=1

if [ -z "$DATABASE_URL_DIRECT" ]; then
  echo "⚠️  DATABASE_URL_DIRECT not set; skipping SQL schema apply"
else
  echo "⏳ prisma/schema_changes.sql..."
  psql "$DATABASE_URL_DIRECT" -v ON_ERROR_STOP=1 -f ./prisma/schema_changes.sql
  echo "⏳ prisma/schema_population.sql..."
  psql "$DATABASE_URL_DIRECT" -v ON_ERROR_STOP=1 -f ./prisma/schema_population.sql
fi

echo "🚀 Starting application..."
exec su -s /bin/sh nextjs -c "node server.js"
EOF
RUN chmod +x /app/entrypoint.sh

RUN mkdir -p /app/.next/cache && chown -R nextjs:nodejs /app/.next

EXPOSE 3000
ENTRYPOINT ["/app/entrypoint.sh"]
